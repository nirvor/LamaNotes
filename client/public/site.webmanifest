{
  "id": "/",
  "name": "LamaNotes",
  "short_name": "LamaNotes",
  "description": "Fast local-first editing with an explicit, media-rich private note library.",
  "scope": "/",
  "share_target": {
    "action": "/capture/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/gif",
            "application/pdf",
            "text/plain",
            "audio/wav",
            "audio/ogg",
            "audio/mpeg",
            "audio/flac",
            "audio/mp4"
          ]
        }
      ]
    }
  },
  "start_url": "/",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "text/markdown": [".md"],
        "text/plain": [".txt", ".cfg", ".ini", ".log"],
        "application/json": [".json"],
        "application/yaml": [".yaml", ".yml"],
        "application/toml": [".toml"],
        "application/xml": [".xml"],
        "text/csv": [".csv"],
        "application/x-tex": [".tex"]
      },
      "launch_type": "single-client"
    }
  ],
  "icons": [
    {
      "src": "brand/lamaui-notes-bc8caa406add-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "brand/lamaui-notes-bc8caa406add-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "brand/lamaui-notes-bc8caa406add-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#082A4C",
  "background_color": "#22262C",
  "display_override": ["window-controls-overlay", "standalone"],
  "display": "standalone",
  "categories": ["productivity", "utilities"]
}
